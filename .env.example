# Copie para .env.local e preencha. Nunca versione valores reais.

# Chave de 32 bytes em base64 para criptografar credenciais de playlists.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Produção: PostgreSQL. Em branco = banco embutido (PGlite) em .data/pglite.
DATABASE_URL=

# Nome exibido no login e na sidebar (o nome definitivo ainda será decidido).
NEXT_PUBLIC_PRODUCT_NAME=Painel Admin

# E-mail de alertas (opcional). Sem isso os alertas ficam na fila como "pendente".
# Ex.: SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
SMTP_URL=
MAIL_FROM=

# Página de ativação mostrada na TV no primeiro acesso (ex.: https://sflgrupo.app/ativar). Em branco = <endereço do painel>/ativar.
PUBLIC_ACTIVATION_URL=
